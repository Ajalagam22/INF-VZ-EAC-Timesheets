# Optional backend/agent provider settings for production extensions.
OPENAI_API_KEY=
DATABASE_URL=
REDIS_URL=
INGESTION_STAGING_DIR=backend/tmp/ingestion_jobs
INGESTION_JOB_POLL_SECONDS=2
INGESTION_JOB_TTL_SECONDS=86400
LLM_PROVIDER=azure_openai
LLM_API_BASE_URL=https://your-resource-name.openai.azure.com/
LLM_API_KEY=your-azure-openai-api-key-here
LLM_MODEL=your-deployment-name
LLM_API_VERSION=2024-12-01-preview
LLM_SKIP_THRESHOLD=85
LLM_CONCURRENCY=20
LLM_CHUNK_SIZE=100
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=30

# Public frontend configuration. These are safe to expose in the Vercel client bundle.
NEXT_PUBLIC_BRAND_NAME=EAC Timesheets
NEXT_PUBLIC_BRAND_SUBTITLE=Weekly Capital Labor Intelligence
# Put the supplied logo/image in frontend/public and reference it here, e.g. /brand-mark.jpg.
# A data:image/... URL also works for quick Vercel demos, but a public asset path is preferred.
NEXT_PUBLIC_BRAND_IMAGE_SRC=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_APP_TITLE=Weekly Timesheet Classification Dashboard
NEXT_PUBLIC_APP_DESCRIPTION=Deterministic, source-agnostic CapEx / OpEx weekly timesheet review.
NEXT_PUBLIC_REVIEWER_VIEW_LABEL=Team Lead Review
NEXT_PUBLIC_RULE_VERSION=fixed-asset-policy-v1.0
NEXT_PUBLIC_PERSONA_NAME=Project Coder Weekly Timesheet
NEXT_PUBLIC_REVIEW_THRESHOLD=70
NEXT_PUBLIC_SEMANTIC_STORE_LABEL=pgvector
NEXT_PUBLIC_DECISION_AUTHORITY_LABEL=Policy-led deterministic rules
